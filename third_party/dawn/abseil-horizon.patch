@@ -21,6 +21,10 @@
 
 #include <stdint.h>
 
+#include <atomic>
+#include <cstddef>
+#include <cstdlib>
+#include <new>
 #include <optional>
 #include <type_traits>
 
@@ -34,7 +38,109 @@
 // LowLevelAlloc requires that the platform support low-level
 // allocation of virtual memory. Platforms lacking this cannot use
 // LowLevelAlloc.
-#ifndef ABSL_LOW_LEVEL_ALLOC_MISSING
+#if defined(__SWITCH__)
+
+namespace absl {
+ABSL_NAMESPACE_BEGIN
+namespace base_internal {
+
+// Horizon has no mmap API. Dawn still needs Abseil's thread identities, so use
+// the platform's thread-safe heap for the small amount of low-level storage
+// those identities require.
+struct LowLevelAlloc::Arena {
+  explicit Arena(bool is_permanent = false)
+      : allocation_count(0), permanent(is_permanent) {}
+
+  std::atomic<size_t> allocation_count;
+  const bool permanent;
+};
+
+namespace {
+
+struct alignas(std::max_align_t) AllocationHeader {
+  LowLevelAlloc::Arena* arena;
+};
+
+LowLevelAlloc::Arena g_default_arena(true);
+std::atomic<LowLevelAlloc::Arena*> g_sig_safe_arena(nullptr);
+
+}  // namespace
+
+LowLevelAlloc::Arena* LowLevelAlloc::DefaultArena() {
+  return &g_default_arena;
+}
+
+void* LowLevelAlloc::Alloc(size_t request) {
+  return AllocWithArena(request, DefaultArena());
+}
+
+void* LowLevelAlloc::AllocWithArena(size_t request, Arena* arena) {
+  if (request == 0) {
+    return nullptr;
+  }
+  if (arena == nullptr) {
+    std::abort();
+  }
+
+  auto* allocation = static_cast<AllocationHeader*>(
+      std::malloc(sizeof(AllocationHeader) + request));
+  if (allocation == nullptr) {
+    std::abort();
+  }
+  allocation->arena = arena;
+  arena->allocation_count.fetch_add(1, std::memory_order_relaxed);
+  return allocation + 1;
+}
+
+void LowLevelAlloc::Free(void* memory) {
+  if (memory == nullptr) {
+    return;
+  }
+  auto* allocation = static_cast<AllocationHeader*>(memory) - 1;
+  allocation->arena->allocation_count.fetch_sub(1, std::memory_order_relaxed);
+  std::free(allocation);
+}
+
+LowLevelAlloc::Arena* LowLevelAlloc::NewArena(uint32_t) {
+  void* storage = std::malloc(sizeof(Arena));
+  if (storage == nullptr) {
+    std::abort();
+  }
+  return new (storage) Arena();
+}
+
+bool LowLevelAlloc::DeleteArena(Arena* arena) {
+  if (arena == nullptr || arena->permanent ||
+      arena->allocation_count.load(std::memory_order_relaxed) != 0) {
+    return false;
+  }
+  arena->~Arena();
+  std::free(arena);
+  return true;
+}
+
+LowLevelAlloc::Arena* SigSafeArena() {
+  return g_sig_safe_arena.load(std::memory_order_acquire);
+}
+
+void InitSigSafeArena() {
+  if (SigSafeArena() != nullptr) {
+    return;
+  }
+  LowLevelAlloc::Arena* new_arena = LowLevelAlloc::NewArena(0);
+  LowLevelAlloc::Arena* expected = nullptr;
+  if (!g_sig_safe_arena.compare_exchange_strong(
+          expected, new_arena, std::memory_order_release,
+          std::memory_order_relaxed)) {
+    LowLevelAlloc::DeleteArena(new_arena);
+  }
+}
+
+}  // namespace base_internal
+ABSL_NAMESPACE_END
+}  // namespace absl
+
